# WARNING:
# Use this file only to create a new local .env when one does not exist yet.
# Do NOT overwrite an existing .env, because it may contain real PostgreSQL credentials
# and environment-specific settings required by your local VESTA installation.

# Webhook secrets
GITHUB_WEBHOOK_SECRET=secretgithubkey
GITLAB_WEBHOOK_SECRET=secretgitlabkey

# Database mode
# false -> build local PostgreSQL URL using ROLE_NAME_POSTGRESQL/PASSWORD_POSTGRESQL
# true  -> use SERVER_WEB directly
AVAILABLE_SERVER=false

# Local PostgreSQL credentials (used when AVAILABLE_SERVER=false)
ROLE_NAME_POSTGRESQL=vesta_role
PASSWORD_POSTGRESQL=vesta_password

# Full DB URL (used when AVAILABLE_SERVER=true)
# Example: postgresql://user:pass@host:5432/vesta_db
SERVER_WEB=

# Prediction calibration thresholds
# >= malicious -> MALICIOUS
# suspicious <= p < malicious -> SUSPICIOUS
# < suspicious -> BENIGN
PREDICTION_THRESHOLD_SUSPICIOUS=0.45
PREDICTION_THRESHOLD_MALICIOUS=0.75

# DAST (Docker sandbox) settings
DAST_ENABLED=true
DAST_DOCKER_IMAGE=python:3.12-alpine
DAST_TIMEOUT_SECONDS=45
DAST_MEMORY_LIMIT=256m
DAST_PIDS_LIMIT=128
DAST_CPU_QUOTA=50000
DAST_NETWORK_MODE=none
DAST_TSHARK_ENABLED=false
DAST_TSHARK_PATH=tshark
DAST_TSHARK_INTERFACE=any
DAST_PROFILE_RELATIVE_PATH=.vesta/dast.profile.json

# Active Defense (Issue 16.1)
# Auto-close OPEN alerts if they have no activity for TTL minutes.
DEFENSE_AUTO_CLOSE_STALE_ALERTS=true
DEFENSE_ALERT_TTL_MINUTES=180
# Keep CRITICAL alerts open by default.
DEFENSE_AUTO_CLOSE_INCLUDE_CRITICAL=false

# Issue 17 - gRPC trigger to containment/honeypot orchestrator
DEFENSE_GRPC_ENABLED=true
DEFENSE_GRPC_TARGET=127.0.0.1:50051
DEFENSE_GRPC_TIMEOUT_SECONDS=3.0
DEFENSE_GRPC_RETRY_MAX=2
DEFENSE_GRPC_RETRY_BACKOFF_SECONDS=0.4
# Trigger only when max alert score in current event >= this threshold
DEFENSE_GRPC_TRIGGER_MIN_SCORE=65.0

# Demo runtime / Docker lab
DEMO_RUNTIME_ENABLED=true
DEMO_RUNTIME_PROVIDER=DEMO_DOCKER
DEMO_RUNTIME_SMARTGRID_HOST_ID=smartgrid-app
DEMO_RUNTIME_SMARTGRID_CONTAINER=vesta-demo-smartgrid-app
DEMO_RUNTIME_DB_CONTAINER=vesta-demo-smartgrid-db
DEMO_RUNTIME_ATTACKER_CONTAINER=vesta-demo-attacker-sim
DEMO_RUNTIME_HONEYPOT_CONTAINER=vesta-demo-honeypot
DEMO_RUNTIME_COLLECTOR_CONTAINER=vesta-demo-collector
DEMO_RUNTIME_PROD_NETWORK=vesta_demo_prod
DEMO_RUNTIME_QUARANTINE_NETWORK=vesta_demo_quarantine
DEMO_RUNTIME_DECEPTION_NETWORK=vesta_demo_deception
DEMO_RUNTIME_HONEYPOT_PORT=2222
