# Webhook secrets
GITHUB_WEBHOOK_SECRET=secretgithubkey
GITLAB_WEBHOOK_SECRET=secretgitlabkey

# Database mode
# false -> build local PostgreSQL URL using ROLE_NAME_POSTGRESQL/PASSWORD_POSTGRESQL
# true  -> use SERVER_WEB directly
AVAILABLE_SERVER=false

# Local PostgreSQL credentials (used when AVAILABLE_SERVER=false)
ROLE_NAME_POSTGRESQL=vesta_role
PASSWORD_POSTGRESQL=vesta_password

# Full DB URL (used when AVAILABLE_SERVER=true)
# Example: postgresql://user:pass@host:5432/vesta_db
SERVER_WEB=
